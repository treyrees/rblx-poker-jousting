--!strict
-- Cards.spec.luau — hand evaluation (GAME_SPEC §2) and card points (§4 *Card values*,
-- *Poker hands multiply*).

local kit = require("./lib/testkit")
local Config = require("../sim/Config")
local Cards = require("../sim/Cards")

local spec = Config.defaults().spec
local L = Cards.list

local function cat(s: string): number
	return Cards.evaluate(L(s)).category
end

kit.describe("Cards: hand evaluation", function()
	kit.it("every category from 7 cards", function()
		kit.expectEqual(cat("2c 7d 9h Js Kc 4d 3s"), Cards.HIGH_CARD)
		kit.expectEqual(cat("2c 2d 9h Js Kc 4d 3s"), Cards.PAIR)
		kit.expectEqual(cat("2c 2d 9h 9s Kc 4d 3s"), Cards.TWO_PAIR)
		kit.expectEqual(cat("2c 2d 2h 9s Kc 4d 7s"), Cards.TRIPS)
		kit.expectEqual(cat("5c 6d 7h 8s 9c Kd 2s"), Cards.STRAIGHT)
		kit.expectEqual(cat("2h 6h 9h Jh Kh 4d 3s"), Cards.FLUSH)
		kit.expectEqual(cat("2c 2d 2h 9s 9c 4d 3s"), Cards.FULL_HOUSE)
		kit.expectEqual(cat("2c 2d 2h 2s 9c 4d 3s"), Cards.QUADS)
		kit.expectEqual(cat("5h 6h 7h 8h 9h Kd 2s"), Cards.STRAIGHT_FLUSH)
	end)
	kit.it("the wheel is a 5-high straight", function()
		local e = Cards.evaluate(L("Ac 2d 3h 4s 5c Kd 9s"))
		kit.expectEqual(e.category, Cards.STRAIGHT)
		kit.expectEqual(e.straightTop, 5)
	end)
	kit.it("a flush beats a straight; two trips make a full house", function()
		kit.expectTrue(Cards.evaluate(L("2h 6h 9h Jh Kh")).value > Cards.evaluate(L("Tc Jd Qh Ks Ac")).value)
		kit.expectEqual(cat("2c 2d 2h 9s 9c 9d 3s"), Cards.FULL_HOUSE)
	end)
	kit.it("kickers break ties (§2 win condition 4)", function()
		local a = Cards.evaluate(L("Ac Ad Kh 7s 5c 3d 2s"))
		local b = Cards.evaluate(L("Ah As Qh 7d 5c 3d 2s"))
		kit.expectTrue(a.value > b.value)
		local c = Cards.evaluate(L("Ah As Kd 7d 5c 3d 2s"))
		kit.expectEqual(a.value, c.value)
	end)
end)

kit.describe("Cards: card points", function()
	kit.it("rank value 1 + (r − 2)/6: 2 = 1, 8 = 2, J = 2.5, A = 3", function()
		kit.expectNear(Cards.rankValue(2, spec), 1)
		kit.expectNear(Cards.rankValue(8, spec), 2)
		kit.expectNear(Cards.rankValue(11, spec), 2.5)
		kit.expectNear(Cards.rankValue(14, spec), 3)
	end)
	kit.it("§4 example: hole 8♣ is 2 points of ♣, J♦ 2.5 of ♦; on the board, half that", function()
		local pts = Cards.points(L("8c Jd"), {}, spec)
		kit.expectNear(pts[1], 2)
		kit.expectNear(pts[4], 2.5)
		local b = Cards.points({}, L("8c Jd"), spec)
		kit.expectNear(b[1], 1)
		kit.expectNear(b[4], 1.25)
	end)
	kit.it("a pocket pair multiplies ×2, in two suits", function()
		local pts, sub = Cards.points(L("8c 8d"), {}, spec)
		kit.expectEqual(sub, 1)
		kit.expectNear(pts[1], 4)
		kit.expectNear(pts[4], 4)
	end)
	kit.it("a board pair is multiplied for both riders at board weight; kickers still count", function()
		local pts = Cards.points(L("2h 3s"), L("Kc Kd 7h"), spec)
		kit.expectNear(pts[1], Cards.rankValue(13, spec) * 0.5 * 2)
		kit.expectNear(pts[4], Cards.rankValue(13, spec) * 0.5 * 2)
		kit.expectNear(pts[3], 1 + Cards.rankValue(7, spec) * 0.5)
	end)
	kit.it("a hole card that pairs the board mixes its weight with the board card's", function()
		local pts = Cards.points(L("Ac 3s"), L("Ad 7h 9h"), spec)
		kit.expectNear(pts[1], 3 * 2)
		kit.expectNear(pts[4], 3 * 0.5 * 2)
	end)
	kit.it("trips ×3; with three pairs only the top two multiply", function()
		local pts, sub = Cards.points(L("5c 5d"), L("5h Ks 2c"), spec)
		kit.expectEqual(sub, 3)
		kit.expectNear(pts[1], Cards.rankValue(5, spec) * 3 + 1 * 0.5)
		local _, sub2 = Cards.points(L("5c 5d"), L("Kh Ks 2c 2d 9h"), spec)
		kit.expectEqual(sub2, 2)
		local p3 = Cards.points(L("5c 5d"), L("Kh Ks 2c 2d 9h"), spec)
		-- Pairs K, 5, 2: K and 5 multiply. 5♣ ×2 in the hole; the board 2♣ unmultiplied at half.
		kit.expectNear(p3[1], Cards.rankValue(5, spec) * 2 + 1 * 0.5)
	end)
	kit.it("a held trick rides as its sub-hand: a full house as trips", function()
		local _, sub = Cards.points(L("9c 9d"), L("9h Ks Kc"), spec)
		kit.expectEqual(sub, 3)
	end)
end)
